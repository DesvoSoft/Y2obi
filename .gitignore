# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
venv/
.venv/
.env
*.egg

# Bundled binaries (fetched at build time, see build.spec and the release workflow)
# Excluding core/* rather than core/ is deliberate: git cannot re-include a file
# inside an excluded directory, and the pinned manifest has to be in the repo.
core/*
!core/whisper/
core/whisper/*
!core/whisper/MANIFEST.json

# Cookies (sensitive, stored per-user in %APPDATA%/Y2obi)
app/cookies/

# PyInstaller build output
dist/

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Claude Code
.claude/settings.local.json
.serena/
CLAUDE.md
